<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/round_bg_light"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewChallengeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textSize="20sp"
            android:textColor="#FFB800"
            android:layout_marginRight="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewChallengeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ProgressBar
                    android:id="@+id/progressBarChallenge"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="30"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/textViewChallengeProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 3"
                    android:textSize="12sp"
                    android:textColor="#888888" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginLeft="8dp">

            <TextView
                android:id="@+id/textViewChallengeXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+500 XP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />

            <TextView
                android:id="@+id/textViewChallengeCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="получено"
                android:textSize="11sp"
                android:textColor="#888888"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/textViewChallengeCompletedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="выполнено в 14:32"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

</LinearLayout>
