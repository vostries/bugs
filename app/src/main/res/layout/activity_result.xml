<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Результаты игры"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#6200EE"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="24dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/textViewFinalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Очки: 0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textViewHits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Попадания: 0"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textViewMisses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Промахи: 0"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textViewAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Точность: 0%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonPlayAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Играть снова"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp" />

</LinearLayout>
